APP_ENV=local
DEBUG=True
ENABLE_DOCS=True
# Use the Supabase Session Pooler (port 5432), not the transaction pooler (6543).
# URL-encode special characters in the database password.
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Tests use local PostgreSQL only. Never point this at Supabase.
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/podclub_test
JWT_SECRET_KEY=not-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=18000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ORIGIN_REGEX=

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=podclub-media
MAX_AUDIO_MB=50
MAX_IMAGE_MB=5
ALLOW_EXTERNAL_MEDIA_URLS=False

RATE_LIMIT_ENABLED=True
LOGIN_RATE_LIMIT=10/minute
REGISTER_RATE_LIMIT=10/hour
PUBLIC_PODCLUBS_RATE_LIMIT=60/minute
INVITE_PREVIEW_RATE_LIMIT=10/minute

SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=admin@podclub.io
SUPERADMIN_PASSWORD=AdminPassword123!
